<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--允许应用访问网络(主要用于检查更新)-->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--允许安装APK-->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />
    <!-- 保存打赏二维码到相册。Android 10 起走 MediaStore 不需要任何权限，
         所以用 maxSdkVersion 把它限制在 9 及以下，新系统上不会出现在权限列表里 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!--添加悬浮窗权限-->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 常驻状态前台服务 + 通知（GKD 同款：靠 START_STICKY 重启带回进程，进而自愈无障碍） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 忽略电池优化：Android 标准保活四要素之一，避免进入 Doze 后被冻结 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--添加写入安全设置权限-->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 仅用于诊断 AppOps 权限状态（GKD 同款），不提供任何免杀能力 -->
    <uses-permission
        android:name="android.permission.GET_APP_OPS_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 允许枚举桌面应用：回放前按录制名称直接调用对应 App，无需 OCR 翻页 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/auto_slide"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoSlide"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 导入配置中转页：透明无 UI，选完文件自动关闭 -->
        <activity
            android:name=".ImportSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.AutoSlide.Translucent" />

        <service
            android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
            android:enabled="true"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:ignore="AccessibilityPolicy">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <service
            android:name=".service.FloatingWindowService"
            android:enabled="true"
            android:exported="false" />
        <!-- 常驻状态服务：显示运行状态，被系统清理后由 START_STICKY 重启带回进程 -->
        <service
            android:name=".service.StatusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Display the running state of the application" />
        </service>
        <!-- 快捷磁贴开关服务 -->
        <service
            android:name=".service.AutoSlideTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_slide_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!--用于与Shizuku服务建立通信-->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!--导出宏配置：通过 FileProvider 分享 slide_settings.xml，无需存储权限 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
