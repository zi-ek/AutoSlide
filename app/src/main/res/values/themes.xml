<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.AutoSlide" parent="Theme.Material3.Light.NoActionBar" tools:targetApi="29">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="colorSurface">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AutoSlide.Dialog</item>
    </style>

    <style name="Theme.AutoSlide" parent="Base.Theme.AutoSlide" />

    <!-- 导入配置的中转 Activity：透明无 UI，一闪而过只负责文件选择 -->
    <style name="Theme.AutoSlide.Translucent" parent="Theme.AutoSlide">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
