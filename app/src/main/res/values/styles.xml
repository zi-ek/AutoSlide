<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础样式占位符：防止使用点号(.)命名法时找不到父类 -->
    <style name="Widget.AutoSlide" parent="" />

    <!-- ==================== 弹窗统一主题 ====================
         所有 MaterialAlertDialogBuilder 构建的弹窗都会自动套用这套样式：
         大圆角（和卡片的 20dp 呼应）、主题色按钮、加粗标题，
         让原生 AlertDialog 风格的弹窗和主界面的 Material3 卡片视觉统一。 -->
    <style name="ThemeOverlay.AutoSlide.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AutoSlide.Dialog</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AutoSlide.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AutoSlide.Dialog.Button.Neutral</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.AutoSlide.Dialog.Button.Neutral</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.AutoSlide.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.AutoSlide.Dialog.Body</item>
    </style>

    <!-- 弹窗圆角：24dp，比卡片(20dp)略大一点，弹窗层级更突出 -->
    <style name="ShapeAppearance.AutoSlide.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- 确认/主操作按钮：主题色加粗文字，不全大写 -->
    <style name="Widget.AutoSlide.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- 取消/次要按钮：次要文字色，不加粗 -->
    <style name="Widget.AutoSlide.Dialog.Button.Neutral" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.AutoSlide.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.AutoSlide.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- ==================== 「我的」页签的列表行 ====================
         行高 54dp、左右 16dp 留白、右侧灰色箭头，三段样式拼出一条可点击的设置项。

         下面几个子样式必须显式写 parent=""：样式名里的点号会让 Android 隐式继承
         同名前缀的父样式（Widget.AutoSlide.MineRow），子控件会跟着继承到
         clickable/focusable/selectableItemBackground——文字和箭头自己变成可点击，
         抢走触摸事件导致整行的 OnClickListener 收不到，同时按下时只有文字那一小条
         泛起水波纹。 -->
    <style name="Widget.AutoSlide.MineRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/margin_medium</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.AutoSlide.MineRow.Title" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--行右侧的附加信息（如版本号），排在标题和箭头之间-->
    <style name="Widget.AutoSlide.MineRow.Value" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.AutoSlide.MineRow.Arrow" parent="">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:src">@drawable/ic_arrow_right</item>
        <item name="android:tint">@color/nav_item_unselected</item>
    </style>

    <style name="Widget.AutoSlide.MineRow.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:layout_marginStart">@dimen/margin_medium</item>
        <item name="android:background">@color/dialog_divider</item>
    </style>

</resources>
