<?xml version="1.0" encoding="utf-8"?>
<!-- 「我的」页签内容：数据统计 + 必要权限（无障碍/悬浮窗/常驻通知）+
     功能入口（使用教程 / 导入配置 / 分享库 / 分享得时长）+ 打赏。
     统计和权限都是「看一眼 / 配一次」的东西，放这里让首页只剩滑动设置和开始按钮。
     版本号放在打赏二维码下方居中显示，点一下即检查更新。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/margin_large">

        <!--数据统计卡片-->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statisticsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_medium"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_statistics"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/totalSwipesText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="128" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_swipes_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/keywordMatchesText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="45" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/keyword_matches_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/savedDistanceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="15.5 米" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/saved_distance_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--权限设置卡片-->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/permissionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_medium"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/title_required_permission"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!--无障碍服务权限-->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/accessibilityServicePermissionSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="23dp"
                            android:contentDescription="@string/accessibility_service_permission_switch"
                            app:thumbTint="@color/switch_thumb_color"
                            app:trackTint="@color/switch_track_color" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="21dp"
                            android:text="@string/bind_accessibility_service"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!--分割线-->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="8dp"
                        android:background="#1A000000" />

                    <!--悬浮窗权限-->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/overlayPermissionSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="21dp"
                            android:contentDescription="@string/overlay_permission_switch"
                            app:thumbTint="@color/switch_thumb_color"
                            app:trackTint="@color/switch_track_color" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/overlay_permission_title"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!--分割线-->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="8dp"
                        android:background="#1A000000" />

                    <!--常驻通知（GKD ControlPage 的「常驻通知」开关）-->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/statusServiceSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="21dp"
                            android:contentDescription="@string/status_service_switch"
                            app:thumbTint="@color/switch_thumb_color"
                            app:trackTint="@color/switch_track_color" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_service_title"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!--保活提示：点击查看磁贴复活说明（被 force-stop 后唯一的复活入口）-->
                <TextView
                    android:id="@+id/keepAliveHintText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/keep_alive_hint_text"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--功能入口列表-->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_medium"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:id="@+id/mineTutorialRow"
                    style="@style/Widget.AutoSlide.MineRow">

                    <TextView
                        style="@style/Widget.AutoSlide.MineRow.Title"
                        android:text="@string/mine_tutorial" />

                    <ImageView
                        style="@style/Widget.AutoSlide.MineRow.Arrow"
                        android:contentDescription="@string/mine_tutorial" />
                </LinearLayout>

                <View style="@style/Widget.AutoSlide.MineRow.Divider" />

                <LinearLayout
                    android:id="@+id/mineImportRow"
                    style="@style/Widget.AutoSlide.MineRow">

                    <TextView
                        style="@style/Widget.AutoSlide.MineRow.Title"
                        android:text="@string/mine_import_settings" />

                    <ImageView
                        style="@style/Widget.AutoSlide.MineRow.Arrow"
                        android:contentDescription="@string/mine_import_settings" />
                </LinearLayout>

                <View style="@style/Widget.AutoSlide.MineRow.Divider" />

                <LinearLayout
                    android:id="@+id/mineScriptLibRow"
                    style="@style/Widget.AutoSlide.MineRow">

                    <TextView
                        style="@style/Widget.AutoSlide.MineRow.Title"
                        android:text="@string/mine_script_library" />

                    <ImageView
                        style="@style/Widget.AutoSlide.MineRow.Arrow"
                        android:contentDescription="@string/mine_script_library" />
                </LinearLayout>

                <View style="@style/Widget.AutoSlide.MineRow.Divider" />

                <LinearLayout
                    android:id="@+id/mineLicenseRow"
                    style="@style/Widget.AutoSlide.MineRow">

                    <TextView
                        style="@style/Widget.AutoSlide.MineRow.Title"
                        android:text="@string/mine_license" />

                    <TextView
                        android:id="@+id/licenseText"
                        style="@style/Widget.AutoSlide.MineRow.Value"
                        tools:text="剩余 27 天" />

                    <ImageView
                        style="@style/Widget.AutoSlide.MineRow.Arrow"
                        android:contentDescription="@string/mine_license" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--微信打赏二维码-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margin_large"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="3dp"
            android:text="@string/donate_tip"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/wxImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margin_small"
            android:adjustViewBounds="true"
            android:contentDescription="@string/donate_qr_desc"
            android:maxWidth="220dp"
            android:maxHeight="220dp"
            android:src="@mipmap/wx" />

        <!--版本号：点一下检查更新（原来在功能列表里的「检查更新」行移到了这里）-->
        <TextView
            android:id="@+id/mineVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margin_medium"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="v3.4.1" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
