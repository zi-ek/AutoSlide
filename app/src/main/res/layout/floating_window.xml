<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮窗布局：
     根布局为可拖拽的 DraggableLinearLayout；
     展开时显示控制面板（上/下/左/右方向键 + 设置 + 关闭），
     收起时只显示一个小圆球（floating_expand_button），点击重新展开 -->
<com.ziek.autoslide.service.DraggableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- 展开后的控制面板（默认显示，收起时隐藏） -->

    <!-- 悬浮球放大时显示的全局暂停/恢复按钮 -->
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/floating_panel_bg"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- 向上滑动按钮（点击启动上滑，长按录制/管理上滑轨迹） -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floating_up_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="3dp"
            android:contentDescription="@string/desc_slide_up"
            android:src="@drawable/ic_floating_arrow_up"
            app:backgroundTint="@color/floating_btn_bg"
            app:elevation="6dp"
            app:fabSize="mini"
            app:tint="@color/floating_btn_icon"
            tools:ignore="ClassNameCheck" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <!-- 向左滑动按钮 -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/floating_left_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:contentDescription="@string/desc_slide_left"
                android:src="@drawable/ic_floating_arrow_left"
                app:backgroundTint="@color/floating_btn_bg"
                app:elevation="6dp"
                app:fabSize="mini"
                app:tint="@color/floating_btn_icon"
                tools:ignore="ClassNameCheck" />

            <!-- 设置按钮：返回主界面 -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/floating_setting_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="3dp"
                android:contentDescription="@string/desc_settings"
                android:src="@drawable/ic_floating_settings"
                app:backgroundTint="@color/floating_btn_settings_bg"
                app:elevation="4dp"
                app:fabSize="mini"
                app:tint="@color/floating_btn_settings_icon"
                tools:ignore="ClassNameCheck" />

            <!-- 向右滑动按钮 -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/floating_right_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:contentDescription="@string/desc_slide_right"
                android:src="@drawable/ic_floating_arrow_right"
                app:backgroundTint="@color/floating_btn_bg"
                app:elevation="6dp"
                app:fabSize="mini"
                app:tint="@color/floating_btn_icon"
                tools:ignore="ClassNameCheck" />
        </LinearLayout>

        <!-- 向下滑动按钮 -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floating_down_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="3dp"
            android:contentDescription="@string/desc_slide_down"
            android:src="@drawable/ic_floating_arrow_down"
            app:backgroundTint="@color/floating_btn_bg"
            app:elevation="6dp"
            app:fabSize="mini"
            app:tint="@color/floating_btn_icon"
            tools:ignore="ClassNameCheck" />

        <!-- 底部按钮行：回放键 + 关闭（X）键 + 录制键 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <!-- 回放：图标 + 下方文字标签 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/floating_play_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:contentDescription="@string/desc_play"
                    android:src="@drawable/ic_chat_refresh"
                    app:backgroundTint="@color/floating_btn_play_bg"
                    app:elevation="4dp"
                    app:fabSize="mini"
                    app:tint="@color/floating_btn_play_icon"
                    tools:ignore="ClassNameCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/label_play"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 关闭：图标 + 下方文字标签 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/floating_close_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:contentDescription="@string/desc_close"
                    android:src="@drawable/ic_floating_close"
                    app:backgroundTint="@color/floating_btn_play_bg"
                    app:elevation="4dp"
                    app:fabSize="mini"
                    app:tint="@color/floating_btn_close_icon"
                    tools:ignore="ClassNameCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/label_close"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 录制：图标 + 下方文字标签 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/floating_record_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:contentDescription="@string/desc_record"
                    android:src="@drawable/ic_floating_record"
                    app:backgroundTint="@color/floating_btn_play_bg"
                    app:elevation="4dp"
                    app:fabSize="mini"
                    app:tint="@color/floating_btn_record_icon"
                    tools:ignore="ClassNameCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/label_record"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floating_pause_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/desc_pause_all"
        android:src="@drawable/ic_floating_pause"
        android:visibility="gone"
        tools:ignore="ClassNameCheck" />

    <!-- 收起状态下的小圆球，点击展开控制面板 -->
    <ImageView
        android:id="@+id/floating_expand_button"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center"
        android:contentDescription="@string/desc_expand"
        android:scaleType="fitCenter"
        android:src="@mipmap/auto_slide"
        android:visibility="gone"
        tools:ignore="ContentDescription" />

</com.ziek.autoslide.service.DraggableLinearLayout>
